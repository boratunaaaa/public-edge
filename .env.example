# Copy to .env on the server (never commit .env).
PE_DB_PASSWORD=change-me
SEC_USER_AGENT=PublicEdge research you@example.com
# Telegram credentials are NOT stored here: scripts/pe.sh interpolates them from TELEGRAM_ENV_FILE.
TELEGRAM_ENV_FILE=/root/crypto-bot/.env
TELEGRAM_ENABLED=1
ALERT_MIN_PRIORITY=5
MAX_ALERTS_PER_HOUR=8
BACKFILL_YEARS=5
# Tailscale IP to expose the dashboard on the private tailnet (default: localhost only)
PE_TAILNET_BIND=127.0.0.1
